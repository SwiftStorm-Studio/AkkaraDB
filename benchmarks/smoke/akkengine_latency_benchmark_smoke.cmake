cmake_minimum_required(VERSION 3.20)
# Exercise the executable's public CLI and real storage paths, without performance thresholds.
if (NOT DEFINED BENCHMARK OR NOT DEFINED WORK_DIR)
    message(FATAL_ERROR "BENCHMARK and WORK_DIR are required")
endif ()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
string(APPEND WORK_DIR "/${run_id}")
file(MAKE_DIRECTORY "${WORK_DIR}")

function(check_output output vlog)
    foreach (expected IN ITEMS "Mean_ns" "Ops/s" "P50_ns" "P90_ns" "P99_ns" "P999_ns"
            "empty timer pair median_ns=" "Verification: passed")
        string(FIND "${output}" "${expected}" found)
        if (found EQUAL -1)
            message(FATAL_ERROR "Missing ${expected} in benchmark output:\n${output}")
        endif ()
    endforeach ()
    set(operations get scan tx.empty tx.get tx.scan put tx.put tx.get_put)
    if (vlog STREQUAL "t")
        list(APPEND operations getAt.oldest getAt.middle getAt.latest)
    else ()
        string(FIND "${output}" "getAt: skipped (vLog=f)" skipped)
        if (skipped EQUAL -1)
            message(FATAL_ERROR "Disabled vLog was not reported")
        endif ()
    endif ()
    foreach (operation IN LISTS operations)
        # Six numeric fields: mean, ops/s, and four individual-call percentiles.
        string(REPLACE "." "[.]" escaped "${operation}")
        string(REGEX MATCH "\n${escaped} +[0-9]+[.][0-9]+ +[0-9]+[.][0-9]+ +[0-9]+[.][0-9]+ +[0-9]+[.][0-9]+ +[0-9]+[.][0-9]+ +[0-9]+[.][0-9]+[\r\n]" row "${output}")
        if (row STREQUAL "")
            message(FATAL_ERROR "Missing numeric metrics for ${operation}:\n${output}")
        endif ()
    endforeach ()
endfunction()

function(check_keys output expected)
    string(FIND "${output}" "Verified distinct keys=${expected}\n" found)
    if (found EQUAL -1)
        # Windows executables can emit CRLF even when execute_process keeps the CR.
        string(FIND "${output}" "Verified distinct keys=${expected}\r\n" found)
    endif ()
    if (found EQUAL -1)
        message(FATAL_ERROR "Expected ${expected} distinct keys:\n${output}")
    endif ()
endfunction()

function(check_csv parent backend iterations keys vlog)
    file(GLOB runs LIST_DIRECTORIES true "${parent}/run-*")
    list(LENGTH runs run_count)
    if (NOT run_count EQUAL 1)
        message(FATAL_ERROR "Expected one unique CSV run folder under ${parent}, got ${run_count}")
    endif ()
    list(GET runs 0 directory)
    file(STRINGS "${directory}/config.csv" settings)
    foreach (entry IN ITEMS "\"backend\",\"${backend}\"" "\"verified_distinct_keys\",\"${keys}\"" "\"verification\",\"passed\"")
        if (NOT entry IN_LIST settings)
            message(FATAL_ERROR "Missing CSV setting ${entry}: ${settings}")
        endif ()
    endforeach ()
    file(STRINGS "${directory}/summary.csv" summary)
    if (NOT "\"measurement_contract_version\",\"2\"" IN_LIST settings)
        message(FATAL_ERROR "Measurement boundary version was not recorded")
    endif ()
    if (ARGC GREATER 5)
        # These comparison cases use two rounds and one warmup per pass.
        math(EXPR expected_calls "4 * (${iterations} + 1) * 2")
        if (NOT "\"verified_engine_read_calls\",\"${expected_calls}\"" IN_LIST settings)
            message(FATAL_ERROR "Actual engine call count did not match the measured/warmup contract")
        endif ()
    endif ()
    file(STRINGS "${directory}/samples.csv" samples)
    if (ARGC GREATER 5)
        set(operations "${ARGV5}")
    else ()
        set(operations get scan tx.empty tx.get tx.scan put tx.put tx.get_put)
        if (vlog STREQUAL "t")
            list(APPEND operations getAt.oldest getAt.middle getAt.latest)
        endif ()
    endif ()
    list(LENGTH operations operation_count)
    math(EXPR expected_summary "${operation_count} + 1")
    math(EXPR expected_samples "${operation_count} * ${iterations} + 1")
    list(LENGTH summary summary_count)
    list(LENGTH samples sample_count)
    if (NOT summary_count EQUAL expected_summary OR NOT sample_count EQUAL expected_samples)
        message(FATAL_ERROR "Incorrect CSV row count: summary=${summary_count}, samples=${sample_count}")
    endif ()
    list(POP_FRONT summary header)
    list(POP_FRONT samples sample_header)
    if (NOT header MATCHES "latency_stddev_ns" OR NOT sample_header STREQUAL "operation,sample_index,latency_ns")
        message(FATAL_ERROR "Missing detailed CSV columns")
    endif ()
    foreach (row IN LISTS summary)
        string(REPLACE "," ";" fields "${row}")
        list(LENGTH fields count)
        if (NOT count EQUAL 28)
            message(FATAL_ERROR "Malformed CSV summary row: ${row}")
        endif ()
        list(GET fields 2 actual_backend)
        list(GET fields 8 actual_iterations)
        list(GET fields 9 actual_keys)
        if (NOT actual_backend STREQUAL "\"${backend}\"" OR NOT actual_iterations EQUAL iterations OR NOT actual_keys EQUAL keys)
            message(FATAL_ERROR "Incorrect CSV workload metadata: ${row}")
        endif ()
    endforeach ()
    foreach (operation IN LISTS operations)
        string(REPLACE "." "[.]" escaped "${operation}")
        set(matches "${samples}")
        list(FILTER matches INCLUDE REGEX "^\"${escaped}\",")
        list(LENGTH matches count)
        if (NOT count EQUAL iterations)
            message(FATAL_ERROR "Incorrect sample count for ${operation}: ${count}")
        endif ()
        set(index 0)
        foreach (row IN LISTS matches)
            if (NOT row MATCHES "^\"${escaped}\",${index},[0-9]+([.][0-9]+)?$")
                message(FATAL_ERROR "Samples lost execution order: ${row}")
            endif ()
            math(EXPR index "${index} + 1")
        endforeach ()
    endforeach ()
endfunction()

foreach (backend IN ITEMS skiplist bptree art)
    foreach (sst IN ITEMS f t)
        foreach (vlog IN ITEMS f t)
            set(csv_dir "${WORK_DIR}/csv space,comma/${backend}-${sst}-${vlog}")
            execute_process(COMMAND "${BENCHMARK}" --backend "${backend}" --sst "${sst}" --vlog "${vlog}"
                    --iterations 3 --warmup 0 --keys 8 --scan-rows 3 --history-depth 3 --csv-dir "${csv_dir}"
                    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 25)
            if (NOT result EQUAL 0)
                message(FATAL_ERROR "Backend=${backend} SST=${sst} vLog=${vlog} failed (${result}): ${output}\n${error}")
            endif ()
            check_output("${output}" "${vlog}")
            check_keys("${output}" 8)
            check_csv("${csv_dir}" "${backend}" 3 8 "${vlog}")
        endforeach ()
    endforeach ()
endforeach ()

# Read-only layer comparison keeps borrowing, allocation and buffer reuse distinct.
set(comparison_operations "")
foreach (round RANGE 1 2)
    foreach (operation IN ITEMS backend.view backend.copy memtable.view memtable.pinned memtable.into engine.get engine.into)
        list(APPEND comparison_operations "${operation}.r${round}")
    endforeach ()
endforeach ()
foreach (backend IN ITEMS skiplist bptree art)
    set(csv_dir "${WORK_DIR}/comparison-${backend}")
    execute_process(COMMAND "${BENCHMARK}" --backend "${backend}" --read-comparison t --comparison-rounds 2
            --iterations 5 --keys 16 --warmup 1 --csv-dir "${csv_dir}"
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 25)
    if (NOT result EQUAL 0 OR NOT output MATCHES "Verification: passed; read comparison complete")
        message(FATAL_ERROR "Read comparison failed: ${output}\n${error}")
    endif ()
    check_csv("${csv_dir}" "${backend}" 5 16 f "${comparison_operations}")
endforeach ()

# Cover tiny sample counts, full-range scans, alternate isolation, and both flag syntaxes.
execute_process(COMMAND "${BENCHMARK}" --sst=t --vlog=t --wal=t --vlog-sync=t
        --iterations=1 --warmup=2 --keys=2 --scan-rows=2 --value-bytes=8 --history-depth=3 --isolation=snapshot
        "--csv-dir=${WORK_DIR}/synced" --backend=bptree
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 25)
if (NOT result EQUAL 0)
    message(FATAL_ERROR "Synced/snapshot mode failed: ${output}\n${error}")
endif ()
check_output("${output}" "t")
check_keys("${output}" 2)
check_csv("${WORK_DIR}/synced" bptree 1 2 t)

# Default data size follows iterations, and explicit --keys works in either order.
foreach (arguments IN ITEMS "--iterations;7" "--keys;5;--iterations;7" "--iterations;7;--keys;9")
    execute_process(COMMAND "${BENCHMARK}" ${arguments} --warmup 0 --csv-dir "${WORK_DIR}/data-size"
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 25)
    if (NOT result EQUAL 0)
        message(FATAL_ERROR "Data size options failed: ${output}\n${error}")
    endif ()
    check_output("${output}" "f")
    if (arguments STREQUAL "--iterations;7")
        check_keys("${output}" 7)
    elseif (arguments STREQUAL "--keys;5;--iterations;7")
        check_keys("${output}" 5)
    else ()
        check_keys("${output}" 9)
    endif ()
endforeach ()

file(MAKE_DIRECTORY "${WORK_DIR}/interactive-memory" "${WORK_DIR}/interactive-components")
file(WRITE "${WORK_DIR}/input.txt" "t\nbptree\n2\n")
execute_process(COMMAND "${BENCHMARK}" INPUT_FILE "${WORK_DIR}/input.txt"
        WORKING_DIRECTORY "${WORK_DIR}/interactive-memory"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 25)
if (NOT result EQUAL 0)
    message(FATAL_ERROR "Interactive memory mode failed: ${output}\n${error}")
endif ()
check_output("${output}" "f")
check_keys("${output}" 2)
check_csv("${WORK_DIR}/interactive-memory/benchmark-results" bptree 2 2 f)

file(WRITE "${WORK_DIR}/input.txt" "f\nf\nf\nart\n1\n")
execute_process(COMMAND "${BENCHMARK}" INPUT_FILE "${WORK_DIR}/input.txt"
        WORKING_DIRECTORY "${WORK_DIR}/interactive-components"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 25)
if (NOT result EQUAL 0)
    message(FATAL_ERROR "Interactive component switches failed: ${output}\n${error}")
endif ()
check_output("${output}" "f")
check_keys("${output}" 1)
check_csv("${WORK_DIR}/interactive-components/benchmark-results" art 1 1 f)

function(reject expected)
    execute_process(COMMAND "${BENCHMARK}" ${ARGN}
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
    string(FIND "${error}" "${expected}" found)
    if (NOT result EQUAL 2 OR found EQUAL -1)
        message(FATAL_ERROR "Expected error '${expected}' for ${ARGN}, got ${result}: ${output}\n${error}")
    endif ()
endfunction()
reject("--iterations must be an int" --iterations 0)
reject("--iterations must be an int" --iterations -1)
reject("--iterations must be an int" --iterations 2147483648)
reject("--iterations must be an int" --iterations 1.5)
reject("--iterations must be an int" --iterations 12x)
reject("--sst must be t or f" --sst true)
reject("missing value" --vlog)
reject("unknown option" --unknown t)
reject("--scan-rows must not exceed --keys" --keys 2 --scan-rows 3)
reject("--scan-rows must not exceed --keys" --iterations 2 --scan-rows 3)
reject("--keys must be an int" --keys 0)
reject("--vlog-sync t requires --vlog t" --vlog-sync t)
reject("--backend must be skiplist, bptree, or art" --backend invalid)
reject("--csv-dir must not be empty" --csv-dir=)
reject("--read-comparison requires" --read-comparison t --sst t)
reject("--read-comparison requires" --read-comparison t --vlog t)
reject("--read-comparison requires" --read-comparison t --wal t)
reject("--comparison-rounds must be an int" --read-comparison t --comparison-rounds 0)

# A real storage failure during the first measured write must leave failure metadata.
set(failed_csv_dir "${WORK_DIR}/injected-failure")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env AKKARADB_TEST_WAL_FAIL_AFTER_ENTRIES=2
        "${BENCHMARK}" --wal t --iterations 2 --keys 2 --warmup 0 --csv-dir "${failed_csv_dir}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 25)
if (NOT result EQUAL 2)
    message(FATAL_ERROR "Injected write failure did not fail the benchmark: ${output}\n${error}")
endif ()
file(GLOB failed_runs LIST_DIRECTORIES true "${failed_csv_dir}/run-*")
list(GET failed_runs 0 failed_run)
file(STRINGS "${failed_run}/config.csv" failed_settings)
foreach (entry IN ITEMS "\"verification\",\"failed\"" "\"failed_stage\",\"put\"")
    if (NOT entry IN_LIST failed_settings)
        message(FATAL_ERROR "Missing failure diagnostic ${entry}: ${failed_settings}")
    endif ()
endforeach ()
if (NOT error MATCHES "WAL injected write failure")
    message(FATAL_ERROR "Original failure reason was lost: ${error}")
endif ()

# A file cannot be an output directory; it must survive a rejected export unchanged.
file(WRITE "${WORK_DIR}/blocked" "preserve existing file")
execute_process(COMMAND "${BENCHMARK}" --iterations 1 --csv-dir "${WORK_DIR}/blocked"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
file(READ "${WORK_DIR}/blocked" contents)
if (NOT result EQUAL 2 OR NOT contents STREQUAL "preserve existing file")
    message(FATAL_ERROR "Failed CSV creation did not preserve existing data: ${output}\n${error}")
endif ()
message(STATUS "Latency benchmark CLI/storage smoke checks passed")
